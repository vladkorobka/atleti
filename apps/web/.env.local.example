# MongoDB — локально або MongoDB Atlas (для Vercel обовʼязково hosted)
MONGODB_URI=mongodb://localhost:27017/atleti

# NextAuth
NEXTAUTH_SECRET=your-secret-here
# Прод-URL застосунку (на Vercel: https://your-app.vercel.app)
NEXTAUTH_URL=http://localhost:3000
# Довіра до хоста за проксі Vercel (рекомендовано в продакшні)
AUTH_TRUST_HOST=true

# Google OAuth
# Прод-callback у Google Console: https://your-app.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
